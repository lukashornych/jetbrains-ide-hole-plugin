#!/bin/sh
# Fake `hole` CLI for the plugin tests (implementation plan, section 4). It implements just enough of Hole 2.6.0's
# `hole start`, `hole list [--json] [--no-gc] [id]`, `hole settings get|create`, `hole modify` and `hole version` to
# exercise the plugin
# without Docker. Error lines look like Hole's: `[ERROR] message`, coloured when stderr is a terminal.
#
# All state lives in $FAKE_HOLE_STATE_DIR (required):
#   instances/<id>.json   one JSON object per running instance, in the `hole list --json` schema
#   calls.log             one line per invocation (the arguments), so tests can count polls
#   leftovers/<id>        `start --instance-id <id>` fails like Hole with leftovers of an abandoned sandbox
#   child.pid, child.int  written by the FAKE_HOLE_CHILD child: its PID, and a marker when SIGINT reached it
#   modify/<id>/<setting> runtime entries `hole modify … add` recorded for an instance, one per line
#
# Behaviour switches (environment):
#   FAKE_HOLE_MODE=old          a Hole before 2.6.0: `version` prints `hole 2.5.0`, `list --json` and
#                               `--instance-id` are rejected as unknown options
#   FAKE_HOLE_MODE=fail         `list` fails like without a container engine
#   FAKE_HOLE_START_EXIT=N      `start` fails with exit code N right after printing the instance ID
#   FAKE_HOLE_HANG=1            `start` ignores SIGINT (Force Stop test; only SIGKILL ends it)
#   FAKE_HOLE_RUNNING_AFTER=S   seconds `start` stays in status `starting` (default 1)
#   FAKE_HOLE_EXIT_AFTER=S      `start` ends by itself after S seconds with exit code 0 (like `/exit`)
#   FAKE_HOLE_LIST_DELAY=S      `list` sleeps S seconds before answering (concurrency tests)
#   FAKE_HOLE_REQUIRE_LIBRARIES=1  `start` fails when the host directory of a `--library PATH[:MOUNT][:rw]` is
#                               missing (Hole only warns), so a test sees that the directory existed at the start
#   FAKE_HOLE_VERSION=TEXT      what `version` prints (default `hole 2.6.0`, `hole 2.5.0` in old mode)
#   FAKE_HOLE_VERSION_EXIT=N    `version` exits with N (default 0)
#   FAKE_HOLE_VERSION_DELAY=S   `version` sleeps S seconds before answering (concurrency tests)
#   FAKE_HOLE_CHILD=1           `start` runs a child process in the foreground right after registering, like Hole's
#                               image build: the child ends only on SIGINT, and `start` handles its own SIGINT only
#                               after the child has ended. So a SIGINT to the process group stops both at once, while
#                               a SIGINT to the `hole` process alone waits for the child forever.
#   FAKE_HOLE_CHILD=running     like 1, but the child starts once the status is `running` (like a process of the
#                               running agent), so a restart of a RUNNING sandbox can be tested with it
#   HOLE_SETTINGS_FILE, HOLE_PROJECT_SETTINGS_FILE   honoured by `settings get` and `settings create` like by Hole
#   FAKE_HOLE_MODIFY_BASE=LIST  base (non-runtime) entries for `modify … list`: `;`-separated `setting=entry@source`,
#                               e.g. `network.allow=api.example.com:443@settings;network.allow=x.example.org@agent:claude`
#   FAKE_HOLE_BLOCKED=LIST      blocked names for `modify … list-blocked`, newest first: `;`-separated
#                               `name|count|firstSeen|lastSeen`; names an allowed runtime entry covers are left out
#   FAKE_HOLE_MODIFY_EXIT=N     every `modify` call fails with exit code N and FAKE_HOLE_MODIFY_MESSAGE (default
#                               `fake modify failure`) as `[ERROR]` line, to simulate exits 2 / 3 / 4
#
# `modify <path> <setting> list|list-blocked|add|remove [values…] --instance-id ID [--json]` follows Hole 2.6.0:
# exit 3 when the instance is not running (or still starting), 2 for an invalid value, a removal of a base entry or
# `network.allow add` in a sandbox started with -u; `add` ignores values that are already there. `list --json` of
# `hole list` reports `runtimeEntryCount` from the recorded entries. FAKE_HOLE_MODE=old rejects `modify`.
#
# `settings create {global|project <path>}` writes Hole's template (`{"$schema": …}`) and creates parent directories;
# an existing file fails with Hole's `settings file already exists: '<path>'; …` (no --overwrite / --append).

set -u
state="${FAKE_HOLE_STATE_DIR:?FAKE_HOLE_STATE_DIR is not set}"
mode="${FAKE_HOLE_MODE:-}"
instances="$state/instances"
mkdir -p "$instances"
echo "$*" >> "$state/calls.log"

error() {
    if [ -t 2 ]; then
        printf '\033[0;31m[ERROR] %s\033[0m\n' "$*" >&2
    else
        printf '[ERROR] %s\n' "$*" >&2
    fi
}

json_escape() {
    printf '%s' "$1" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g'
}

# runtime_count <id>: number of entries `modify … add` recorded for the instance
runtime_count() {
    cat "$state/modify/$1"/* 2>/dev/null | grep -c . || true
}

# write_instance <file> <status>; uses the variables set by `start`
write_instance() {
    tmp="$1.tmp"
    cat > "$tmp" <<JSON
{
  "instanceId": "$id",
  "instanceName": "$(json_escape "$project_name")-$id",
  "status": "$2",
  "agent": "$(json_escape "$agent")",
  "profile": "$(json_escape "$profile")",
  "projectPath": "$(json_escape "$project_path")",
  "projectName": "$(json_escape "$project_name")",
  "startedAt": "$started_at",
  "uptimeSeconds": 0,
  "docker": $with_docker,
  "networks": ["hole-$(json_escape "$project_name")-${id}_sandbox"],
  "settings": ["global(~/.hole/settings.json)"],
  "settingsFiles": [],
  "runtimeEntryCount": $(runtime_count "$id"),
  "flags": {
    "debug": $debug,
    "rebuild": $rebuild,
    "unrestricted": $unrestricted,
    "dumpNetworkAccess": $dump,
    "withDocker": $with_docker
  },
  "pid": $$,
  "version": "2.6.0"
}
JSON
    mv "$tmp" "$1"
}

cmd_list() {
    if [ -n "${FAKE_HOLE_LIST_DELAY:-}" ]; then sleep "$FAKE_HOLE_LIST_DELAY"; fi
    json=false
    filter=""
    for arg in "$@"; do
        case "$arg" in
            --json|--no-gc)
                if [ "$mode" = "old" ]; then error "unknown option '$arg'; run 'hole help' for usage"; exit 1; fi
                [ "$arg" = "--json" ] && json=true ;;
            -*) error "unknown option '$arg'; run 'hole help' for usage"; exit 1 ;;
            *) filter="$arg" ;;
        esac
    done
    if [ "$mode" = "old" ]; then
        if [ -n "$filter" ]; then
            error "unexpected argument '$filter'; usage: hole list"
            exit 1
        fi
    fi
    if [ "$mode" = "fail" ]; then
        error "neither docker nor podman is installed"
        exit 1
    fi
    if [ "$json" = false ]; then
        echo "INSTANCE  AGENT  PROJECT"
        for file in "$instances"/*.json; do
            [ -f "$file" ] || continue
            echo "$(basename "$file" .json)  -  -"
        done
        exit 0
    fi
    printf '['
    first=true
    for file in "$instances"/*.json; do
        [ -f "$file" ] || continue
        if [ -n "$filter" ] && [ "$(basename "$file" .json)" != "$filter" ]; then
            continue
        fi
        if [ "$first" = true ]; then first=false; else printf ','; fi
        cat "$file"
    done
    printf ']\n'
    exit 0
}

cmd_settings() {
    subcommand="${1:-}"
    case "$subcommand" in
        get|create) ;;
        *) error "invalid settings subcommand '${1:-}'; expected create, open or get"; exit 1 ;;
    esac
    case "${2:-}" in
        global)
            path="${HOLE_SETTINGS_FILE:-$HOME/.hole/settings.json}"
            hint="hole settings create global" ;;
        project)
            if [ -z "${3:-}" ]; then error "no project path given"; exit 1; fi
            if ! dir="$(cd "$3" 2>/dev/null && pwd -P)"; then
                error "directory '$3' does not exist"
                exit 1
            fi
            path="${HOLE_PROJECT_SETTINGS_FILE:-$dir/.hole/settings.json}"
            hint="hole settings create project $3" ;;
        *) error "invalid settings scope '${2:-}'; expected project or global"; exit 1 ;;
    esac
    case "$path" in
        /*) ;;
        *) error "settings file path '$path' must be an absolute path"; exit 1 ;;
    esac
    if [ "$subcommand" = create ]; then
        if [ -e "$path" ]; then
            error "settings file already exists: '$path'; use --overwrite to replace it or --append to add the template fields"
            exit 1
        fi
        mkdir -p "$(dirname "$path")"
        printf '{\n  "$schema": "https://example.invalid/hole/settings.schema.json"\n}\n' > "$path"
        echo "[INFO] Created $path" >&2
        exit 0
    fi
    if [ ! -f "$path" ]; then
        error "settings file '$path' does not exist; create it with '$hint'"
        exit 1
    fi
    echo "$path"
    exit 0
}

cmd_version() {
    if [ -n "${FAKE_HOLE_VERSION_DELAY:-}" ]; then sleep "$FAKE_HOLE_VERSION_DELAY"; fi
    default="hole 2.6.0"
    [ "$mode" = "old" ] && default="hole 2.5.0"
    echo "${FAKE_HOLE_VERSION:-$default}"
    exit "${FAKE_HOLE_VERSION_EXIT:-0}"
}

cmd_start() {
    agent_spec=""
    path=""
    id=""
    debug=false; rebuild=false; unrestricted=false; dump=false; with_docker=false
    while [ $# -gt 0 ]; do
        case "$1" in
            --) shift; break ;;
            -d|--debug) debug=true ;;
            -r|--rebuild) rebuild=true ;;
            -u|--unrestricted-network) unrestricted=true ;;
            -n|--dump-network-access) dump=true ;;
            --with-docker) with_docker=true ;;
            --trust-project|--update-agents) ;;
            --library)
                shift
                library="${1:-}"
                if [ "${FAKE_HOLE_REQUIRE_LIBRARIES:-}" = "1" ] && [ ! -d "${library%%:*}" ]; then
                    error "library '${library%%:*}' does not exist"
                    exit 1
                fi ;;
            --instance-id)
                if [ "$mode" = "old" ]; then error "unknown option '$1'; run 'hole help' for usage"; exit 1; fi
                shift; id="${1:-}" ;;
            -*) error "unknown option '$1'; run 'hole help' for usage"; exit 1 ;;
            *)
                if [ -z "$agent_spec" ]; then agent_spec="$1"
                elif [ -z "$path" ]; then path="$1"
                else error "unexpected argument '$1'; agent arguments go after '--'"; exit 1
                fi ;;
        esac
        shift
    done
    if [ "$debug" = true ] && [ $# -gt 0 ]; then
        error "--debug and agent arguments (after --) cannot be used together"
        exit 1
    fi
    if [ -z "$agent_spec" ]; then error "no agent given"; exit 1; fi
    if [ -z "$path" ]; then error "no project path given"; exit 1; fi
    if ! printf '%s' "$id" | grep -Eq '^[a-z0-9]{6}$'; then
        error "invalid instance ID '$id': expected 6 characters a-z, 0-9"
        exit 1
    fi
    file="$instances/$id.json"
    if [ -f "$file" ]; then
        other="$(sed -n 's/.*"projectPath": "\([^"]*\)".*/\1/p' "$file" | head -n 1)"
        error "instance ID '$id' is already in use by ${other:-/somewhere/else}"
        exit 1
    fi
    if [ -f "$state/leftovers/$id" ]; then
        error "instance ID '$id' has leftovers of an abandoned sandbox; run 'hole list' to clean them up"
        exit 1
    fi
    if ! project_path="$(cd "$path" 2>/dev/null && pwd -P)"; then
        error "directory '$path' does not exist"
        exit 1
    fi
    agent="${agent_spec%%:*}"
    profile=""
    case "$agent_spec" in *:*) profile="${agent_spec#*:}" ;; esac
    project_name="$(basename "$project_path")"
    started_at="$(date -u +%Y-%m-%dT%H:%M:%SZ)"

    write_instance "$file" starting
    echo "Instance ID: $id"

    if [ -n "${FAKE_HOLE_START_EXIT:-}" ]; then
        rm -f "$file"
        error "fake start failure"
        exit "$FAKE_HOLE_START_EXIT"
    fi

    teardown() {
        write_instance "$file" stopping
        echo "Destroying sandbox $id..."
        sleep 0.3
        rm -f "$file"
        exit "$1"
    }
    if [ "${FAKE_HOLE_HANG:-}" = "1" ]; then
        trap '' INT
    else
        trap 'teardown 130' INT
        trap 'teardown 143' TERM
        trap 'teardown 129' HUP
    fi

    # foreground, like Hole waiting for `docker compose build`; the shell runs its own trap only once it ends
    run_child() {
        sh -c 'trap "echo interrupted > \"\$1/child.int\"; exit 130" INT; echo $$ > "$1/child.pid"
               while :; do sleep 0.1; done' fake-hole-child "$state"
    }
    if [ "${FAKE_HOLE_CHILD:-}" = "1" ]; then
        echo "Building image..."
        run_child
    fi

    running_after="${FAKE_HOLE_RUNNING_AFTER:-1}"
    exit_after="${FAKE_HOLE_EXIT_AFTER:-}"
    running_ticks="$(awk "BEGIN { print int($running_after * 10) }")"
    exit_ticks="$(awk "BEGIN { print int(${exit_after:-0} * 10) }")"
    ticks=0
    status=starting
    while :; do
        sleep 0.1
        ticks=$((ticks + 1))
        if [ "$status" = starting ] && [ "$ticks" -ge "$running_ticks" ]; then
            status=running
            write_instance "$file" running
            echo "Starting $agent agent..."
            if [ "${FAKE_HOLE_CHILD:-}" = "running" ]; then run_child; fi
        fi
        if [ -n "$exit_after" ] && [ "$ticks" -ge "$exit_ticks" ]; then
            teardown 0
        fi
    done
}

cmd_modify() {
    m_path=""; m_setting=""; m_op=""; m_id=""; m_json=false; m_values=""
    while [ $# -gt 0 ]; do
        case "$1" in
            --instance-id) shift; m_id="${1:-}" ;;
            --json) m_json=true ;;
            -*) error "unknown option '$1'; run 'hole help' for usage"; exit 1 ;;
            *)
                if [ -z "$m_path" ]; then m_path="$1"
                elif [ -z "$m_setting" ]; then m_setting="$1"
                elif [ -z "$m_op" ]; then m_op="$1"
                else m_values="$m_values
$1"
                fi ;;
        esac
        shift
    done
    if [ -n "${FAKE_HOLE_MODIFY_EXIT:-}" ]; then
        error "${FAKE_HOLE_MODIFY_MESSAGE:-fake modify failure}"
        exit "$FAKE_HOLE_MODIFY_EXIT"
    fi
    case "$m_setting" in
        network.allow|network.hostGatewayDomains) ;;
        *) error "setting '$m_setting' is not modifiable at runtime; modifiable settings: network.allow, network.hostGatewayDomains"; exit 2 ;;
    esac
    case "$m_op" in
        list|add|remove) ;;
        list-blocked)
            if [ "$m_setting" != network.allow ]; then
                error "invalid operation 'list-blocked' for $m_setting; expected one of: add, remove, list, edit"; exit 1
            fi ;;
        *) error "invalid operation '$m_op' for $m_setting"; exit 1 ;;
    esac
    instance="$instances/$m_id.json"
    if [ ! -f "$instance" ]; then
        error "no sandbox with instance ID '$m_id' is running for $m_path"; exit 3
    fi
    if grep -q '"status": "starting"' "$instance"; then
        error "sandbox $m_id is still starting; try again once it runs"; exit 3
    fi
    runtime="$state/modify/$m_id/$m_setting"
    mkdir -p "$state/modify/$m_id"
    touch "$runtime"
    case "$m_op" in
        list)
            if [ "$m_json" != true ]; then cat "$runtime"; exit 0; fi
            printf '{"instanceId": "%s", "entries": [' "$m_id"
            first=true
            old_ifs="$IFS"; IFS=';'
            for item in ${FAKE_HOLE_MODIFY_BASE:-}; do
                IFS="$old_ifs"
                [ "${item%%=*}" = "$m_setting" ] || continue
                rest="${item#*=}"
                if [ "$first" = true ]; then first=false; else printf ', '; fi
                printf '{"entry": "%s", "source": "%s"}' "$(json_escape "${rest%@*}")" "$(json_escape "${rest##*@}")"
            done
            IFS="$old_ifs"
            while IFS= read -r entry; do
                [ -n "$entry" ] || continue
                if [ "$first" = true ]; then first=false; else printf ', '; fi
                printf '{"entry": "%s", "source": "runtime"}' "$(json_escape "$entry")"
            done < "$runtime"
            printf '], "futureField": true}\n'
            exit 0 ;;
        list-blocked)
            printf '{"instanceId": "%s", "blocked": [' "$m_id"
            first=true
            old_ifs="$IFS"; IFS=';'
            for item in ${FAKE_HOLE_BLOCKED:-}; do
                IFS="$old_ifs"
                name="${item%%|*}"; rest="${item#*|}"
                count="${rest%%|*}"; rest="${rest#*|}"
                first_seen="${rest%%|*}"; last_seen="${rest#*|}"
                allowed=false
                while IFS= read -r entry; do
                    host="${entry%%:*}"
                    case "$host" in
                        "$name") allowed=true ;;
                        \*.*) case "$name" in *"${host#\*}") allowed=true ;; esac ;;
                    esac
                done < "$runtime"
                [ "$allowed" = false ] || continue
                if [ "$first" = true ]; then first=false; else printf ', '; fi
                printf '{"name": "%s", "count": %s, "firstSeen": "%s", "lastSeen": "%s"}' "$name" "$count" "$first_seen" "$last_seen"
            done
            IFS="$old_ifs"
            printf ']}\n'
            exit 0 ;;
    esac
    if [ -z "$m_values" ]; then error "$m_op needs at least one value"; exit 1; fi
    if [ "$m_op" = add ] && [ "$m_setting" = network.allow ] && grep -q '"unrestricted": true' "$instance"; then
        error "sandbox $m_id runs with unrestricted network access (-u); network.allow cannot change"; exit 2
    fi
    printf '%s\n' "$m_values" | while IFS= read -r value; do
        [ -n "$value" ] || continue
        case "$value" in
            *" "*|:*|*::*) error "invalid entry '$value'"; exit 2 ;;
        esac
        if [ "$m_op" = remove ] && ! grep -qxF "$value" "$runtime"; then
            if printf '%s' "${FAKE_HOLE_MODIFY_BASE:-}" | tr ';' '\n' | sed 's/@[^@]*$//' | grep -qxF "$m_setting=$value"; then
                error "'$value' comes from the sandbox's settings or an agent and cannot be removed"; exit 2
            fi
            error "'$value' is not a runtime entry of $m_setting"; exit 2
        fi
    done || exit $?
    printf '%s\n' "$m_values" | while IFS= read -r value; do
        [ -n "$value" ] || continue
        if [ "$m_op" = add ]; then
            grep -qxF "$value" "$runtime" || echo "$value" >> "$runtime"
        else
            grep -vxF "$value" "$runtime" > "$runtime.tmp" || true
            mv "$runtime.tmp" "$runtime"
        fi
    done
    count="$(runtime_count "$m_id")"
    sed "s/\"runtimeEntryCount\": [0-9]*/\"runtimeEntryCount\": $count/" "$instance" > "$instance.tmp" && mv "$instance.tmp" "$instance"
    exit 0
}

command="${1:-help}"
[ $# -gt 0 ] && shift
case "$command" in
    list) cmd_list "$@" ;;
    start) cmd_start "$@" ;;
    settings) cmd_settings "$@" ;;
    modify)
        if [ "$mode" = "old" ]; then error "invalid command 'modify'"; exit 1; fi
        cmd_modify "$@" ;;
    version) cmd_version ;;
    help) echo "Usage: hole {command} {agent}[:{profile}] {path} [options]"; exit 0 ;;
    *) error "invalid command '$command'"; exit 1 ;;
esac
